<?xml version="1.0" encoding="UTF-8"?>
<RULES>
	<APPLICABLE_IF>
		<GLOBAL_ATTRIBUTE NAME="title" VALUE="Glider vertical profile"/>
		<GLOBAL_ATTRIBUTE NAME="user_manual_version" VALUE="1.11"/>
		<VARIABLE NAME="DATA_TYPE" VALUE="EGO profile                     "/>
		<VARIABLE NAME="FORMAT_VERSION" VALUE="2.0 "/>
	</APPLICABLE_IF>
	
	<MANDATORY>
		<!-- ==================== -->
		<!-- Mandatory dimensions -->
		<!-- ==================== -->
		<DIMENSION NAME="DATE_TIME" VALUE="14"/>
		<DIMENSION NAME="STRING256" VALUE="256"/>
		<DIMENSION NAME="STRING64" VALUE="64"/>
		<DIMENSION NAME="STRING32" VALUE="32"/>
		<DIMENSION NAME="STRING16" VALUE="16"/>
		<DIMENSION NAME="STRING8" VALUE="8"/>
		<DIMENSION NAME="STRING4" VALUE="4"/>
		<DIMENSION NAME="STRING2" VALUE="2"/>
		<DIMENSION NAME="N_PROF"/>
		<DIMENSION NAME="N_PARAM"/>
		<DIMENSION NAME="N_LEVELS"/>
		<DIMENSION NAME="N_CALIB"/>
		<DIMENSION NAME="N_HISTORY" VALUE="0"/>
		
		<!-- =========================== -->
		<!-- Mandatory global attributes -->
		<!-- =========================== -->
		<GLOBAL_ATTRIBUTE NAME="title" VALUE="Glider vertical profile"/>
		<GLOBAL_ATTRIBUTE NAME="institution"/>
		<GLOBAL_ATTRIBUTE NAME="source" VALUE="Glider"/>
		<GLOBAL_ATTRIBUTE NAME="references"/>
		<GLOBAL_ATTRIBUTE NAME="comment"/>
		<GLOBAL_ATTRIBUTE NAME="user_manual_version" VALUE="1.11"/>
		<GLOBAL_ATTRIBUTE NAME="Conventions" VALUE="EGO-2.0 CF-1.6"/>
		<GLOBAL_ATTRIBUTE NAME="featureType" VALUE="trajectoryProfile"/>
		
		<!-- =================== -->
		<!-- Mandatory variables -->
		<!-- =================== -->
		
		<!-- General information on the profile file -->
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="DATA_TYPE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="STRING32" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Data type"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 1"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="FORMAT_VERSION"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="STRING4" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="File format version"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="HANDBOOK_VERSION"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="STRING4" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Data handbook version"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="REFERENCE_DATE_TIME"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="DATE_TIME" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Date of reference for Julian days"/>
				<ATTRIBUTE NAME="conventions" VALUE="YYYYMMDDHHMISS"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="DATE_CREATION"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="DATE_TIME" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Date of file creation"/>
				<ATTRIBUTE NAME="conventions" VALUE="YYYYMMDDHHMISS"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="DATE_UPDATE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="DATE_TIME" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Date of update of this file"/>
				<ATTRIBUTE NAME="conventions" VALUE="YYYYMMDDHHMISS"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		
		<!-- General information for each profile -->
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="PLATFORM_NUMBER"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING8" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Glider unique identifier"/>
				<ATTRIBUTE NAME="conventions" VALUE="WMO float identifier : A9IIIII"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="PROJECT_NAME"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING64" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Name of the project"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="PI_NAME"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING64" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Name of the principal investigator"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="STATION_PARAMETERS"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="3"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="N_PARAM" RANK="2"/>
				<DIMENSION NAME="STRING64" RANK="3"/>
				<ATTRIBUTE NAME="long_name" VALUE="List of available parameters for the station"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 3"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="CYCLE_NUMBER"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="int"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Glider descent or ascent number"/>
				<ATTRIBUTE NAME="conventions" VALUE="1...N"/>
				<ATTRIBUTE NAME="_FillValue" VALUE="99999"/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="DIRECTION"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Direction of the station profiles"/>
				<ATTRIBUTE NAME="conventions" VALUE="A: ascending profiles, D: descending profiles"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="DATA_CENTRE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING2" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Data centre in charge of glider data processing"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 4"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="DC_REFERENCE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING32" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Station unique identifier in data centre"/>
				<ATTRIBUTE NAME="conventions" VALUE="Data centre convention"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="DATA_STATE_INDICATOR"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING4" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Degree of processing the data have passed through"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 5"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="DATA_MODE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Delayed mode or real time data"/>
				<ATTRIBUTE NAME="conventions" VALUE="R : real time; D : delayed mode; A : real time with adjustment"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="PARAMETER_DATA_MODE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="N_PARAM" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Delayed mode or real time data"/>
				<ATTRIBUTE NAME="conventions" VALUE="R : real time; D : delayed mode; A : real time with adjustment"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="PLATFORM_TYPE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING32" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Type of glider"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 23"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="GLIDER_SERIAL_NO"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING32" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Serial number of the glider"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="FIRMWARE_VERSION"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING64" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Instrument firmware version"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="WMO_INST_TYPE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING4" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Coded instrument type"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 8"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="JULD"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="double"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Julian day (UTC) of the station relative to REFERENCE_DATE_TIME"/>
				<ATTRIBUTE NAME="standard_name" VALUE="time"/>
				<ATTRIBUTE NAME="units" VALUE="days since 1950-01-01 00:00:00 UTC"/>
				<ATTRIBUTE NAME="conventions" VALUE="Relative julian days with decimal part (as parts of day)"/>
				<ATTRIBUTE NAME="resolution"/>
				<ATTRIBUTE NAME="_FillValue" VALUE="999999"/>
				<ATTRIBUTE NAME="axis" VALUE="T"/>
				<OPTIONAL_ATTRIBUTE NAME="comment_on_resolution"/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="JULD_QC"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Quality on date and time"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 2.1"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="JULD_LOCATION"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="double"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Julian day (UTC) of the location relative to REFERENCE_DATE_TIME"/>
				<ATTRIBUTE NAME="units" VALUE="days since 1950-01-01 00:00:00 UTC"/>
				<ATTRIBUTE NAME="conventions" VALUE="Relative julian days with decimal part (as parts of day)"/>
				<ATTRIBUTE NAME="resolution"/>
				<ATTRIBUTE NAME="_FillValue" VALUE="999999"/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="LATITUDE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="double"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Latitude of the station, best estimate"/>
				<ATTRIBUTE NAME="standard_name" VALUE="latitude"/>
				<ATTRIBUTE NAME="units" VALUE="degree_north"/>
				<ATTRIBUTE NAME="_FillValue" VALUE="99999"/>
				<ATTRIBUTE NAME="valid_min" VALUE="-90"/>
				<ATTRIBUTE NAME="valid_max" VALUE="90"/>
				<ATTRIBUTE NAME="axis" VALUE="Y"/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="LONGITUDE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="double"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Longitude of the station, best estimate"/>
				<ATTRIBUTE NAME="standard_name" VALUE="longitude"/>
				<ATTRIBUTE NAME="units" VALUE="degree_east"/>
				<ATTRIBUTE NAME="_FillValue" VALUE="99999"/>
				<ATTRIBUTE NAME="valid_min" VALUE="-180"/>
				<ATTRIBUTE NAME="valid_max" VALUE="180"/>
				<ATTRIBUTE NAME="axis" VALUE="X"/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="POSITION_QC"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Quality on position (latitude and longitude)"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 2.1"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="POSITIONING_SYSTEM"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING8" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Positioning system"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="VERTICAL_SAMPLING_SCHEME"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="STRING256" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="Vertical sampling scheme"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 16"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="CONFIG_MISSION_NUMBER"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="int"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" VALUE="Unique number denoting the missions performed by the float"/>
				<ATTRIBUTE NAME="conventions" VALUE="1...N, 1 : first complete mission"/>
				<ATTRIBUTE NAME="_FillValue" VALUE="99999"/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		
		<!-- Calibration information for each profile -->
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="PARAMETER"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="4"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="N_CALIB" RANK="2"/>
				<DIMENSION NAME="N_PARAM" RANK="3"/>
				<DIMENSION NAME="STRING64" RANK="4"/>
				<ATTRIBUTE NAME="long_name" VALUE="List of parameters with calibration information"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 3"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="SCIENTIFIC_CALIB_EQUATION"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="4"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="N_CALIB" RANK="2"/>
				<DIMENSION NAME="N_PARAM" RANK="3"/>
				<DIMENSION NAME="STRING256" RANK="4"/>
				<ATTRIBUTE NAME="long_name" VALUE="Calibration equation for this parameter"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="SCIENTIFIC_CALIB_COEFFICIENT"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="4"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="N_CALIB" RANK="2"/>
				<DIMENSION NAME="N_PARAM" RANK="3"/>
				<DIMENSION NAME="STRING256" RANK="4"/>
				<ATTRIBUTE NAME="long_name" VALUE="Calibration coefficients for this equation"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="SCIENTIFIC_CALIB_COMMENT"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="4"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="N_CALIB" RANK="2"/>
				<DIMENSION NAME="N_PARAM" RANK="3"/>
				<DIMENSION NAME="STRING256" RANK="4"/>
				<ATTRIBUTE NAME="long_name" VALUE="Comment applying to this parameter calibration"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		<VARIABLE>
			<IDENTIFY>
				<NAME VALUE="SCIENTIFIC_CALIB_DATE"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="4"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="N_CALIB" RANK="2"/>
				<DIMENSION NAME="N_PARAM" RANK="3"/>
				<DIMENSION NAME="DATE_TIME" RANK="4"/>
