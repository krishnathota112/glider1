				<OPTIONAL_ATTRIBUTE NAME="valid_max"/>
				<OPTIONAL_ATTRIBUTE NAME="axis"/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		
		<!-- profile parameter QC -->
		<VARIABLE>
			<IDENTIFY>
				<NAME PATTERN="PROFILE.*_QC"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="1"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<ATTRIBUTE NAME="long_name" PATTERN="Global quality flag of .* profile"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 2.1a"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
		
		<!-- parameter QC -->
		<VARIABLE>
			<IDENTIFY>
				<NAME PATTERN="(?!JULD|POSITION|PROFILE).*_QC"/>
			</IDENTIFY>
			<MUST_VERIFY>
				<TYPE VALUE="char"/>
				<DIMENSION_COUNT VALUE="2"/>
				<DIMENSION NAME="N_PROF" RANK="1"/>
				<DIMENSION NAME="N_LEVELS" RANK="2"/>
				<ATTRIBUTE NAME="long_name" VALUE="quality flag"/>
				<ATTRIBUTE NAME="conventions" VALUE="EGO reference table 2.1"/>
				<ATTRIBUTE NAME="_FillValue" VALUE=" "/>
				<NO_OTHER_ATTRIBUTE/>
			</MUST_VERIFY>
		</VARIABLE>
	</OPTIONAL>
</RULES>
